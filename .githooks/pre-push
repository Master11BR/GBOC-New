#!/bin/sh
# GBOC - ultima barreira antes do GitHub:
#  1) reexamina os commits enviados (caso alguem tenha usado --no-verify);
#  2) bloqueia exclusao de branch remota e push forcado (reescrita de historico),
#     a menos que GBOC_ALLOW_FORCE=1 seja definido conscientemente.
HOOK_DIR=$(dirname "$0")
. "$HOOK_DIR/gboc-protect.sh"
ZERO=0000000000000000000000000000000000000000
rc=0
while read -r local_ref local_sha remote_ref remote_sha; do
    if [ "$local_sha" = "$ZERO" ]; then
        if [ "$GBOC_ALLOW_FORCE" != "1" ]; then
            echo "[GBOC] BLOQUEADO: exclusao da branch remota $remote_ref (defina GBOC_ALLOW_FORCE=1 se for intencional)." >&2
            rc=1
        fi
        continue
    fi
    if [ "$remote_sha" = "$ZERO" ]; then
        range="$local_sha --not --remotes"
    else
        if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
            if [ "$GBOC_ALLOW_FORCE" != "1" ]; then
                echo "[GBOC] BLOQUEADO: push forcado em $remote_ref apagaria commits remotos (defina GBOC_ALLOW_FORCE=1 se for intencional)." >&2
                rc=1
                continue
            fi
        fi
        if git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
            range="$remote_sha..$local_sha"
        else
            range="$local_sha --not --remotes"   # commit remoto desconhecido localmente (ex.: historico reescrito)
        fi
    fi
    for c in $(git rev-list $range 2>/dev/null); do
        git diff-tree --no-commit-id --name-only -r --diff-filter=ACMR "$c" | gboc_check_paths || { echo "   (commit $c)" >&2; rc=1; }
        git show --format= -U0 --diff-filter=ACMR "$c" | grep -v 'gboc-allow-secret' | gboc_check_content "commit $c" || rc=1
    done
done
[ $rc -ne 0 ] && echo "[GBOC] Push cancelado." >&2
exit $rc
