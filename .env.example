# GBOC - variaveis de ambiente opcionais (copie para .env; .env nunca vai para o Git)

# --- Segurança ---
# Primeiro acesso (criação do admin) permitido de qualquer origem (padrão: só máquina local/rede privada)
GBOC_SETUP_ALLOW_ANY=0
# Origens extras liberadas no CORS do Servidor (mesmo host em outra porta já é liberado). "*" = antigo.
GBOC_SERVER_CORS_ORIGINS=
# TLS Agente -> Servidor (escolha uma; padrão aceita certificado autoassinado como antes)
GBOC_SERVER_CERT_SHA256=
GBOC_SERVER_CA_BUNDLE=
GBOC_SERVER_TLS_VERIFY=0

# --- Logs do Kopia ---
GBOC_KOPIA_LOG_MAX_FILES=100
GBOC_KOPIA_CONTENT_LOG_MAX_FILES=100
GBOC_KOPIA_LOG_MAX_AGE=168h
GBOC_KOPIA_LOG_MAX_MB=50
